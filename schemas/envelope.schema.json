{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restoke.com/schemas/copilot-protocol/envelope.schema.json",
  "title": "ProtocolEnvelope",
  "type": "object",
  "additionalProperties": true,
  "required": ["message_id", "message_type", "channel", "content"],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "content": {},
    "error": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
