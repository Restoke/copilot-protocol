{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadyEvent",
  "type": "object",
  "required": ["type", "protocol_version"],
  "properties": {
    "type": { "const": "READY" },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "min_client_version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
