{
  "name": "turn-lifecycle",
  "rules": [
    "exactly_one_turn_complete_per_accepted_turn",
    "turn_complete_without_more_must_be_last_server_frame",
    "turn_complete_with_more_true_requires_one_final_turn_settled",
    "only_optional_widgets_between_turn_complete_and_turn_settled",
    "no_error_or_answer_fragments_after_turn_complete",
    "no_server_frames_after_terminal_frame_before_next_client_turn",
    "message_ended_is_not_terminal",
    "error_is_not_terminal"
  ]
}
